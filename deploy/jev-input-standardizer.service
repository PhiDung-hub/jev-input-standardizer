[Unit]
Description=Jev JSON/TOON/CSV context standardizer bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/typesafe/env
Environment=JEV_STANDARDIZER_LISTEN=127.0.0.1:8788
ExecStart=%h/.local/bin/jev-input-standardizer-server
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=default.target
